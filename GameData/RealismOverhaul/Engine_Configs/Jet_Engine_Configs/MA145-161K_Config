//	==================================================
//	Engine: MA145-161
//
//	Manufacturer: Marquardt
//
//	=================================================================================
//	MA145-161
//	1968, Planned uprated version of the MA145-XAB 
//	Envelope up to M6.3@85.0kft?
//
//	Dry Mass: 1461 kg
//	Thrust: 716.16 kN
//	Area: 1.824 m^2		//Compressor Area
//	Mdes: 6.0 M			//Mach Design Point
//	Tdes: 225 K			//Temp Design Point
//	eta_n: 0.98			//Efficiency at afterburner rear / nozzle entrance
//	FHV: 64800000 J		//Fuel heat of burning
//	maxFar: 0.07		//Max fuel to air ratio  (purely a guess at the moment)
//	maxEngineTemp: 6300 K	//Engine max temperature
//	=================================================================================

//	Sources:

//	https://arc.aiaa.org/doi/abs/10.2514/1.9200?journalCode=jsr
//  https://ntrs.nasa.gov/api/citations/19710072317/downloads/19710072317.pdf
//  https://ntrs.nasa.gov/api/citations/19710072318/downloads/19710072318.pdf


//	Used by:

//	Notes:

//	60 inches dia
//	design M6.0 @ 25.9 km, sfc 1.49
//	==================================================
@PART[*]:HAS[#engineType[MA145-161K]]:FOR[RealismOverhaulEngines]
{

	%title = #roMA145-161Title	//MA145 Ramjet (161klbf)
	%manufacturer = #roMfrMarquardt
	%description = #roMA145-161Desc

	@tags ^= :$: usa marquardt MA-145 MA145 ramjet

	%specLevel = prototype	//operational, prototype, concept, speculative, altHist, sciFi

	@MODULE[ModuleEngines*]
	{
		@name = ModuleEnginesAJERamjet
		%EngineType = Turbine
		@PROPELLANT[LiquidFuel]
		{
			@name = Kerosene
		}
	}

	!MODULE[ModuleAlternator]{}
	!MODULE[ModuleGimbal]{}

	MODULE
	{
		name = ModuleEngineConfigs
		type = ModuleEnginesAJERamjet
		configuration = MA-145-161K
		modded = false
		origMass = 1.46

		CONFIG
		{
			name = MA-145-161K
			description = MA-145, as tested in 1968, uprated for 161,000 lbf. Design speed M6.0@25.9 km.
			specLevel = prototype
			massMult = 1.00
			heatProduction = 10
			
			Area = 1.824		//Compressor Area
			Mdes = 6.0		//Mach Design Point
			Tdes = 225		//Temp Design Point
			eta_n = 0.98		//Efficiency at afterburner rear / nozzle entrance
			FHV = 64800000	//Fuel heat of burning (joules?)
			maxFar = 0.07
			maxEngineTemp = 6300
			thrustUpperLimit = 716.16
			
			// Engine fitting params
			maxThrust = 716.16	//Just to let MEC know thrust
			throttleResponseMultiplier = 1.0

			PROPELLANT
			{
				name = LqdHydrogen
				ratio = 1.0
				DrawGauge = True
			}
		}
	}
}
